# Unsplash API Key（可选，用于补充菜谱图片缓存）
# 在 https://unsplash.com/developers 注册获取免费 Access Key
UNSPLASH_ACCESS_KEY=

# 服务端口（默认 7777）
PORT=7777

# 维护接口令牌（可选）。配置后 /api/update、/api/import-howtocook 等
# 写操作需要请求头 Authorization: Bearer <token> 或 X-Admin-Token: <token>
# 留空则不校验（家庭局域网场景）
ADMIN_TOKEN=

# 可选：拉取 GitHub raw 资源的代理（同步卡路里/厨艺技巧用）
# HTTP_PROXY=http://127.0.0.1:7890

# 可选：设为 1 跳过卡路里补充（同步加速）
# SYNC_SKIP_CALORIES=1
